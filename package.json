{
  "name": "spoon",
  "productName": "Spoon",
  "version": "0.1.0",
  "description": "Spoon - a fast, local-first, open-source desktop Git client.",
  "main": "./out/main/index.js",
  "author": "Spoon contributors",
  "license": "MIT",
  "homepage": "https://github.com/Barkerbg001/spoon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Barkerbg001/spoon.git"
  },
  "bugs": {
    "url": "https://github.com/Barkerbg001/spoon/issues"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "npm run build && playwright test",
    "perf": "vitest run --config vitest.perf.config.ts",
    "icons": "electron scripts/generate-icons.mjs",
    "licenses": "node scripts/license-inventory.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "package": "npm run build && electron-builder --publish never",
    "package:dir": "npm run build && electron-builder --dir --publish never",
    "package:win": "npm run build && electron-builder --win --publish never",
    "package:mac": "npm run build && electron-builder --mac --publish never",
    "package:linux": "npm run build && electron-builder --linux --publish never"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-virtual": "^3.14.14",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.55.0",
    "prettier": "^3.9.10",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.3.7",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  }
}
